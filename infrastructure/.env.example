# ==========================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# Copy this file to .env and use these values
# to connect to the local Docker containers.
# ==========================================

# 1. PostgreSQL (with PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=rapid_user
DB_PASSWORD=rapid_password
DB_NAME=rapid_db
# For Go/Python standard connection strings:
DATABASE_URL=postgres://rapid_user:rapid_password@localhost:5432/rapid_db?sslmode=disable

# 2. Redis
REDIS_URL=redis://localhost:6379

# 3. RabbitMQ
# Format: amqp://user:password@host:port/
RABBITMQ_URL=amqp://rapid_user:rapid_password@localhost:5672/

# 4. MinIO (Local Google Cloud Storage Emulator)
# Note: Using port 9002 for the API as configured in docker-compose
STORAGE_ENDPOINT=http://localhost:9002
STORAGE_ACCESS_KEY=rapid_admin
STORAGE_SECRET_KEY=rapid_password_123

# 5. Local AI Model (Placeholder for Ollama/etc)
AI_MODEL_URL=http://localhost:11434/api/generate
